---
title: Showcase
pagination:
    data: collections.gameTags
    size: 1
    alias: category
permalink: showcase/{{ (category | slugify) if category !== "all" }}/
---
{% extends "layouts/base.layout.njk" %}

{% block content %}
    <section class="mg-showcase-hero" aria-labelledby="monogame-showcase">
        <div class="container-xxl mg-showcase-hero-inner">
            <div class="mg-showcase-hero-logos" aria-hidden="true"></div>
            <div class="mg-showcase-hero-copy">
                <nav class="mg-about-breadcrumb mg-showcase-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span aria-hidden="true">›</span>
                    <span>Showcase</span>
                </nav>
                <h1 id="monogame-showcase">A universe of games, built with MonoGame.</h1>
                <p class="mg-showcase-lede">
                    Discover a selection of the games, libraries, and tools brought to life by the MonoGame community—from beloved classics to hidden gems.
                </p>
                <a class="btn btn-lg mg-outline-button mg-showcase-submit hide-external-icon"
                   href="https://github.com/MonoGame/monogame.github.io/issues/new?assignees=&labels=showcase&projects=&template=01_Showcase_Submission.yml">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Submit your project</span>
                </a>
            </div>
        </div>
    </section>

    <section class="container-xxl mg-showcase-filter" aria-labelledby="showcase-filter-title">
        <div class="mg-showcase-filter-heading">
            <div>
                <p class="mg-showcase-eyebrow">Browse the collection</p>
                <h2 id="showcase-filter-title">Find your next favourite</h2>
            </div>
        </div>
        <nav class="mg-showcase-filter-list" aria-label="Showcase categories">
            {% for filterCategory in collections.gameTags %}
                {% set isActive = (filterCategory === "all" and page.url === "/showcase/") or filterCategory in page.url %}
                <a href="/showcase/{{ (filterCategory | slugify) if filterCategory !== "all" }}"
                   class="mg-showcase-filter-pill{{ " active" if isActive }}"
                   data-showcase-category="{{ filterCategory }}"
                   {% if isActive %}aria-current="page"{% endif %}>
                    <span>{{ "All" if filterCategory === "all" else filterCategory }}</span>
                    <span class="mg-showcase-filter-count" aria-label="projects"></span>
                </a>
            {% endfor %}
        </nav>
    </section>

    <section class="container-xxl mb-5 mg-showcase-gallery-section" aria-labelledby="showcase-gallery-title">
        <div class="mg-showcase-gallery-heading">
            <h2 id="showcase-gallery-title">{{ "All projects" if category === "all" else category }}</h2>
            <span id="showcase-gallery-count">{{ games | length }} projects and counting</span>
        </div>
        <div id="showcase-gallery" class="mg-showcase-grid">
            {% for game in games %}
                {% set isVisible = category in game.tags or category === "all" %}
                <a class="mg-showcase-card mg-no-link hide-external-icon"
                   href="{{ game.url }}"
                   title="Visit {{ game.title }}"
                   data-showcase-tags="{{ game.tags | join('|') }}"
                   {% if not isVisible %}hidden{% endif %}>
                    <div class="mg-showcase-card-media">
                        <div class="mg-showcase-card-image"
                             style="background-image: url('/images/showcase-header/{{ game.screenshot }}');
                                    image-rendering: {{ "pixelated" if game.pixelart else "auto"}}">
                        </div>
                        {% if game.logo %}
                            <img class="mg-showcase-card-logo"
                                 src="/images/showcase-header/{{ game.logo }}"
                                 alt=""
                                 loading="lazy"
                                 decoding="async">
                        {% endif %}
                        </div>
                        <div class="mg-showcase-card-body">
                            <h3>{{ game.title }}</h3>
                            <div class="mg-showcase-card-platforms" aria-label="Supported platforms">
                                {% for tag in game.tags %}
                                    {% if tag === "Windows" or tag === "Windows Phone" %}
                                        <span title="{{ tag }}" aria-label="{{ tag }}">{% include 'svgs/logos/windows.svg' %}</span>
                                    {% elif tag === "Mac" %}
                                        <span title="macOS" aria-label="macOS">{% include 'svgs/logos/apple.svg' %}</span>
                                    {% elif tag === "Linux" %}
                                        <span title="Linux" aria-label="Linux">{% include 'svgs/logos/linux.svg' %}</span>
                                    {% elif tag === "Android" %}
                                        <span title="Android" aria-label="Android">{% include 'svgs/logos/android.svg' %}</span>
                                    {% elif tag === "iOS" %}
                                        <span title="iOS" aria-label="iOS">{% include 'svgs/logos/ios.svg' %}</span>
                                    {% elif tag === "Xbox One" or tag === "Xbox Series X/S" %}
                                        <span title="{{ tag }}" aria-label="{{ tag }}">{% include 'svgs/logos/xbox_one.svg' %}</span>
                                    {% elif tag === "Playstation 4" or tag === "Playstation 5" or tag === "Playstation Vita" %}
                                        <span title="{{ tag }}" aria-label="{{ tag }}">{% include 'svgs/logos/playstation.svg' %}</span>
                                    {% elif tag === "Nintendo Switch" %}
                                        <span title="Nintendo Switch" aria-label="Nintendo Switch">{% include 'svgs/logos/nintendo_switch.svg' %}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block scripts %}
    <script type="text/javascript" src="/js/showcaseRandomizer.js"></script>
{% endblock %}
