---
title: Blog
eleventyExcludeFromCollections: true
pagination:
    data: collections.blogTags
    size: 1
    alias: category
permalink: blog/{{ (category | slugify) if category !== "all" }}/
---
{% extends 'layouts/base.layout.njk' %}

{% block content %}
    <section class="mg-blog-hero" aria-labelledby="monogame-blog">
        <div class="container-xxl mg-blog-hero-inner">
            <div class="mg-blog-hero-copy">
                <nav class="mg-about-breadcrumb mg-blog-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span aria-hidden="true">›</span>
                    <span>Blog</span>
                </nav>
                <h1 id="monogame-blog">News, notes, and progress from MonoGame.</h1>
                <p>Stay current with framework releases, community stories, Foundation news, and practical ways to build with MonoGame.</p>
            </div>
        </div>
    </section>

    <section class="container-xxl mg-showcase-filter" aria-labelledby="blog-filter-title">
        <div class="mg-showcase-filter-heading">
            <div>
                <p class="mg-showcase-eyebrow">Explore the archive</p>
                <h2 id="blog-filter-title">Latest from the blog</h2>
            </div>
        </div>
        <nav class="mg-showcase-filter-list" aria-label="Blog categories">
            {% for filterCategory in collections.blogTags %}
                {% set isActive = (filterCategory === "all" and page.url === "/blog/") or filterCategory in page.url %}
                <a href="/blog/{{ (filterCategory | slugify) if filterCategory !== "all" }}"
                   class="mg-showcase-filter-pill{{ " active" if isActive }}"
                   data-blog-category="{{ filterCategory }}"
                   {% if isActive %}aria-current="page"{% endif %}>
                    <span>{{ "All" if filterCategory === "all" else filterCategory }}</span>
                    <span class="mg-showcase-filter-count" aria-label="posts"></span>
                </a>
            {% endfor %}
        </nav>
    </section>

    <section class="container-xxl mb-5" aria-labelledby="blog-gallery-title">
        <div class="mg-showcase-gallery-heading">
            <h2 id="blog-gallery-title">{{ "All posts" if category === "all" else category }}</h2>
            <span id="blog-gallery-count">{{ collections.blogPosts | length }} posts</span>
        </div>
        <div id="blog-gallery" class="mg-blog-grid">
            {% for post in collections.blogPosts | reverse %}
                {% set postTags = [post.data.tags] if post.data.tags is string else post.data.tags %}
                {% set isVisible = category in postTags or category === "all" %}
                <a class="mg-blog-card hide-external-icon"
                   href="{{ post.url }}"
                   data-blog-tags="{{ postTags | join('|') }}"
                   {% if not isVisible %}hidden{% endif %}>
                    <div class="mg-blog-card-media" style="background-image: url('{{ post.data.image }}');"></div>
                    <div class="mg-blog-card-body">
                        <div class="mg-blog-card-meta">
                            <span>{{ postTags[0] | default('News') }}</span>
                            <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
                        </div>
                        <h3>{{ post.data.title }}</h3>
                        <p>{{ post.data.excerpt }}</p>
                        <span class="mg-blog-card-read">Read article <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block scripts %}
    <script type="text/javascript" src="/js/blogFilter.js"></script>
{% endblock %}
