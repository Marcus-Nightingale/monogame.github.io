{# Creates a section containing tags from the given categories that can be #}
{# used to click to filter the items on a page based on those categories #}
{# This version supports multi-tag filtering with client-side JavaScript #}
{% macro create_multi_tag_filter(categories, basePath, currentPath) %}
    <section class="container-xxl my-5 mg-resource-filter" aria-labelledby="resource-filter-title">
        <h2 id="resource-filter-title">Categories</h2>
        <nav class="mg-showcase-filter-list" id="tag-filter-container" aria-label="Resource categories">
            {% for category in categories %}
                {% set isActive = (category === "all" and currentPath === basePath) or category in currentPath %}
                {% set displayCategory = category | capitalize %}
                {% if category === "2d" %}{% set displayCategory = "2D" %}{% endif %}
                {% if category === "3d" %}{% set displayCategory = "3D" %}{% endif %}
                {% if category === "ai" %}{% set displayCategory = "AI" %}{% endif %}
                {% if category === "ui" %}{% set displayCategory = "UI" %}{% endif %}
                {% if category === "sound effects" %}{% set displayCategory = "Sound Effects" %}{% endif %}
                <a href="{{ basePath }}{{ (category | slugify) if category !== "all" }}"
                   class="mg-showcase-filter-pill{{ " active" if isActive }}"
                   data-resource-category="{{ category | lower }}"
                   data-resource-label="{{ "All" if category === "all" else displayCategory }}"
                   {% if isActive %}aria-current="page"{% endif %}>
                    <span class="mg-resource-filter-label">{{ "All" if category === "all" else displayCategory }}</span>
                    <span class="mg-showcase-filter-count" aria-label="resources"></span>
                </a>
            {% endfor %}
        </nav>
    </section>
{% endmacro %}
