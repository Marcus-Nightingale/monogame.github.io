                        <li class="nav-item">
                            <a class="hide-external-icon nav-link mg-nav-link {{ 'active' if page.url === navlink.url }}" href="{{ navlink.url }}" {{ 'aria-current="page"' if page.url === navlink.url }}>
                                <span>{{ navlink.label }}</span>
                                {% if navlink.label == "Foundation" %}
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                {% endif %}
