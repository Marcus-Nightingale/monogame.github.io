<div class="dropdown bd-mode-toggle mg-theme-toggle">
    <button
        class="btn mg-theme-toggle-button dropdown-toggle d-flex align-items-center justify-content-center"
        id="bd-theme"
        type="button"
        aria-expanded="false"
        data-bs-toggle="dropdown"
        aria-label="Toggle colour theme">
        <i id="active-theme-icon" class="bi bi-circle-half" aria-hidden="true"></i>
        <span class="visually-hidden" id="bd-theme-text">Toggle colour theme</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end mg-theme-menu shadow" aria-labelledby="bd-theme-text">
        <li>
            <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-bs-theme-value="light" aria-pressed="false">
                <i class="bi bi-sun" aria-hidden="true"></i>
                <span>Light</span>
            </button>
        </li>
        <li>
            <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-bs-theme-value="dark" aria-pressed="false">
                <i class="bi bi-moon" aria-hidden="true"></i>
                <span>Dark</span>
            </button>
        </li>
        <li>
            <button
                type="button"
                class="dropdown-item d-flex align-items-center gap-2 active"
                data-bs-theme-value="auto"
                aria-pressed="true">
                <i class="bi bi-circle-half" aria-hidden="true"></i>
                <span>Auto</span>
            </button>
        </li>
    </ul>
</div>